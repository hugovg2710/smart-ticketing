# ==========================================
# APLICACIÓN
# ==========================================
APP_PORT=8080

# ==========================================
# BASE DE DATOS (Docker)
# ==========================================
# Cambia las contraseñas antes de desplegar en cualquier entorno compartido.
DB_HOST=db
DB_NAME=app_db
DB_USER=smart_ticketing
DB_PASSWORD=cambia_esta_password
DB_ROOT_PASSWORD=cambia_esta_password_root
DB_EXPOSED_PORT=3306

# ==========================================
# USUARIO ADMINISTRADOR (php src/create_admin.php)
# ==========================================
# Si ADMIN_PASSWORD se deja vacío, el script genera una contraseña aleatoria y la muestra una vez.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ==========================================
# GOOGLE GMAIL API (OAuth 2.0)
# ==========================================
# Credenciales de tu proyecto en Google Cloud Console (tipo "Aplicación web")
GOOGLE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui
# URL de redirección autorizada en Google Cloud (por defecto, entorno local)
GOOGLE_REDIRECT_URI=http://localhost:8080/settings/callback

# ==========================================
# GOOGLE GEMINI API (IA)
# ==========================================
# Genera tu API key en Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
